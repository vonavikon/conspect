# Conspect self-host — настройки сервера.
# Скопируйте этот файл в `.env` и заполните обязательные поля.

# --- LLM (OpenAI-compatible) ---
# bothub.chat по умолчанию: один ключ к DeepSeek/GLM/GPT/Gemini, оплата в ₽, без VPN.
# Подойдёт любой OpenAI-совместимый эндпоинт (OpenAI, Groq, OpenRouter, vLLM и т.п.).
LLM_API_KEY=
LLM_BASE_URL=https://openai.bothub.chat/v1
LLM_MODEL=deepseek-v4-flash
MAX_TOKENS=8192
LLM_TIMEOUT_SEC=300

# --- Пайплайн ---
# Максимальная длительность видео в минутах (длиннее — отказ 413).
MAX_DURATION_MIN=180
YTDLP_PROBE_TIMEOUT_SEC=90
YTDLP_DOWNLOAD_TIMEOUT_SEC=180

# --- Сервер ---
PORT=3000
# Интерфейс, на котором слушает сервер. Относится к запуску без Docker: 127.0.0.1 —
# только этот компьютер, снаружи не достучаться. В Docker значение перекрывается на
# 0.0.0.0 из docker-compose.yml (иначе проброс порта не работает), а закрытость даёт
# привязка порта к 127.0.0.1 хоста.
HOST=127.0.0.1
# Разрешённые origin для CORS, через запятую. Пусто — запрет (по умолчанию).
# Расширение ходит на localhost напрямую (host_permissions в manifest), CORS не нужен.
# Для публичного VPS укажите точный origin расширения chrome-extension://<id>.
CORS_ORIGIN=

# --- Безопасность ---
# Общий секрет между расширением и сервером. ОБЯЗАТЕЛЬНО задайте длинную случайную
# строку (минимум 24 символа). Тот же токен вводится в настройках расширения.
# Без него любой, кто узнал адрес публичного сервера, потратит ваш LLM-ключ.
SHARED_TOKEN=change-me-to-a-long-random-string

# --- Rate limit ---
# Глобальная защита от сжигания LLM-ключа: сервер знает один токен, а не пользователей.
# Лимиты общие — максимум одновременных генераций и запусков в минуту.
MAX_CONCURRENT_DIGESTS=2
RATE_LIMIT_PER_MIN=10

# --- yt-dlp ---
# Автообновление yt-dlp при старте (yt-dlp -U). 1 = включить. По умолчанию 0.
YTDLP_AUTO_UPDATE=0
