{
  "name": "conspect-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Конспект — структурированный конспект YouTube по клику. Chrome MV3.",
  "type": "module",
  "scripts": {
    "build": "node scripts/make-icons.mjs && node build.mjs",
    "watch": "node build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "sharp": "^0.35.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.21.0",
    "@fontsource-variable/onest": "^5.2.11",
    "@fontsource/pt-mono": "^5.2.8",
    "antd": "^5.21.0",
    "antd-style": "^3.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.1.7",
    "framer-motion": "^12.42.0",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
